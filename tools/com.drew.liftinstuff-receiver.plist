<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Starts tools/lift_receiver.py at login and keeps it running.
     Installed by tools/setup_mac_receiver.sh (safe to re-run) -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.drew.liftinstuff-receiver</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/python3</string>
        <string>/Users/drewattar/liftinstuff-data/lift_receiver.py</string>
    </array>
    <key>WorkingDirectory</key>
    <string>/Users/drewattar/liftinstuff-data</string>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/Users/drewattar/liftinstuff-data/logs/receiver.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/drewattar/liftinstuff-data/logs/receiver.log</string>
</dict>
</plist>
